# generated by reswatch setup — re-run to change
# Starts res-watch when you log in. Manage with:
#   systemctl --user status reswatch     journalctl --user -u reswatch -f
[Unit]
Description=res-watch resource monitor
After=default.target

[Service]
WorkingDirectory={{workdir}}
ExecStart={{python}} -m reswatch --host 127.0.0.1 --port {{port}}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
