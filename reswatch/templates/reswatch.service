# generated by reswatch setup — re-run to change
# Install:
#   sudo cp deploy/reswatch.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now reswatch
# Logs: journalctl -u reswatch -f
[Unit]
Description=res-watch resource monitor
After=network-online.target
Wants=network-online.target

[Service]
User={{user}}
WorkingDirectory={{workdir}}
Environment=RESWATCH_CONFIG_DIR={{config_dir}}
ExecStart={{python}} -m reswatch --host 127.0.0.1 --port {{port}} {{flags}}
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
