# generated by reswatch setup — re-run to change
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-gpu.txt ./
# GPU=1 installs NVIDIA NVML bindings (needs the NVIDIA container toolkit at run time)
ARG GPU={{gpu_build}}
RUN pip install --no-cache-dir -r requirements.txt \
 && if [ "$GPU" = "1" ]; then pip install --no-cache-dir -r requirements-gpu.txt; fi
COPY reswatch ./reswatch
COPY static ./static
ENV PYTHONUNBUFFERED=1 RESWATCH_HOST=0.0.0.0 RESWATCH_PORT=8000 RESWATCH_CONFIG_DIR=/config
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request,os;urllib.request.urlopen('http://127.0.0.1:8000'+os.environ.get('RESWATCH_BASE_PATH','')+'/healthz')"
# Seeing host processes requires running with --pid=host (docker run) / pid: host (compose).
CMD ["python", "-m", "reswatch"]
